Тест 3:
Входные данные:
def inc(num):
    return num + 1

def dec(num):
    return num - 1

def repeater(value, n=10):
    return str(value) * n

def square(num):
    return num ** 2

print(compute([repeater, dec, inc, square], 5, 7, 0, True))

